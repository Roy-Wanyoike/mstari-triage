# Copy to .env.local for local dev; on Vercel add these in Project Settings -> Environment Variables.
# Server-only: never shipped to the browser, never committed.

# Challenge-provided ModelScope Qwen endpoint (open-weights Qwen family)
MODELSCOPE_BASE_URL=https://api-inference.modelscope.ai/v1
MODELSCOPE_MODEL=Qwen-Ambassador/Qwen3.8-plus
MODELSCOPE_API_KEY=your-modelscope-token-here
# Available models:
#   Qwen-Ambassador/Qwen3.7-Max
#   Qwen-Ambassador/Qwen3.8-Max
#   Qwen-Ambassador/Qwen3.8-plus
#   Qwen-Ambassador/Qwen3.7-Plus

# No key set? The desk still runs - extraction falls back to the deterministic
# keyword matcher and every card says so honestly.

# Neon Postgres (Vercel marketplace) - demo storage for the queue board, gate
# ledger and audit trail across page refreshes and redeploys. Create the
# database from Vercel -> Storage -> Neon (or app.neon.tech), copy the POOLED
# connection string, and set it as DATABASE_URL locally / on Vercel.
# Unset? The desk still runs end-to-end with in-memory session storage and
# the header pill reports which backend is live (honest mode).
#DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
