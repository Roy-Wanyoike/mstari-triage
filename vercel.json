{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "core": {
      "root": ".",
      "runtime": "python",
      "entrypoint": "api/index.py"
    },
    "web": {
      "root": "web",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    { "source": "/", "destination": { "service": "web" } },
    { "source": "/core", "destination": { "service": "core" } },
    { "source": "/core/:path*", "destination": { "service": "core" } },
    { "source": "/:path*", "destination": { "service": "web" } }
  ]
}

