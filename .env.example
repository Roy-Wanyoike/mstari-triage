# Copy to .env and fill in. .env is git-ignored and must NEVER be committed.
# Mstari reads MSTARI_LLM_* at startup (mstari/config.py, tiny built-in loader).

# Lane 1 - sovereign open-weights lane (default for the demo): local Ollama.
#   Patient data never leaves the machine. Install: https://ollama.com
#   ollama pull qwen2.5:7b
#MSTARI_LLM_BASE_URL=http://localhost:11434/v1
#MSTARI_LLM_MODEL=qwen2.5:7b
#MSTARI_LLM_API_KEY=

# Lane 2 - challenge-provided ModelScope Qwen endpoint (synthetic data only).
MSTARI_LLM_BASE_URL=https://api-inference.modelscope.ai/v1
MSTARI_LLM_MODEL=Qwen-Ambassador/Qwen3.8-plus
MSTARI_LLM_API_KEY=your-modelscope-token-here

# Switch between the challenge's available models by changing the model name:
#   Qwen-Ambassador/Qwen3.7-Max
#   Qwen-Ambassador/Qwen3.8-Max
#   Qwen-Ambassador/Qwen3.8-plus
#   Qwen-Ambassador/Qwen3.7-Plus

# No endpoint reachable? Mstari still runs end-to-end in deterministic
# heuristic mode and says so honestly in every card and summary.
