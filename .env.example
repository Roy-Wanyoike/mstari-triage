# Copy to .env and fill in. NEVER commit .env.
#
# Sovereign open-weights lane (default for the demo - patient data never
# leaves the machine). Ollama example:
MSTARI_LLM_BASE_URL=http://localhost:11434/v1
MSTARI_LLM_MODEL=qwen2.5:7b

# Frontier lane (SYNTHETIC DATA ONLY per the track rules; all Mstari data is
# synthetic). Example with ModelScope API-Inference:
# MSTARI_LLM_BASE_URL=https://api-inference.modelscope.ai/v1
# MSTARI_LLM_MODEL=Qwen-Ambassador/Qwen3.7-Max
# MSTARI_LLM_API_KEY=your-key-here

# Leave MSTARI_LLM_BASE_URL unset to run fully offline in deterministic
# heuristic mode (the README always says honestly which mode was used).
